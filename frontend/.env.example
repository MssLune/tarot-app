# Copiar a .env y ajustar según el entorno.
#
# Sólo se exponen al navegador las variables que empiezan con VITE_. Cualquier
# clave secreta que se ponga acá queda en el bundle que descarga el usuario.
# Las claves privadas de Clerk (CLERK_SECRET_KEY) van en backend/.env, nunca acá.

# ---------------------------------------------------------------------------
# URL base de la API de Arcana.
# En desarrollo el backend corre en el puerto 4000 (ver backend/.env).
# En producción tiene que ser la URL pública del backend, con https.
# ---------------------------------------------------------------------------
VITE_API_URL="http://localhost:4000/api"

# ---------------------------------------------------------------------------
# Clerk (obligatorio para la autenticación).
#
# La clave publicable sale de https://dashboard.clerk.com/~/api-keys y se llama
# "Publishable key". Empieza con pk_test_ en desarrollo y pk_live_ en producción.
#
# Debe ser del MISMO entorno (instancia) que el CLERK_SECRET_KEY del backend: si
# el frontend apunta a una instancia y el backend a otra, los tokens no se
# validan y la app cae en 401 aunque el usuario haya iniciado sesión.
# ---------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
