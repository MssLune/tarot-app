# Copiar a .env y ajustar según el entorno.

# Base de datos PostgreSQL (Neon). En el panel de Neon → Connect:
#   DATABASE_URL: la cadena CON pooler (el host lleva "-pooler"). La usa la app.
#   DIRECT_URL:   la cadena SIN pooler. La usan las migraciones.
# Usa una rama de Neon para desarrollo y otra (main) para producción, así
# las pruebas no tocan los datos reales.
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Puerto donde escucha la API.
PORT=4000

# Origen permitido para CORS (el dev server de Vite). En Vercel: la URL del
# frontend, por ejemplo https://arcana.vercel.app (sin barra al final).
FRONTEND_URL="http://localhost:5173"

# Entorno de ejecución.
NODE_ENV=development

# Clerk (obligatorio para autenticación).
# La secret y la publishable salen de https://dashboard.clerk.com/~/api-keys
# y deben ser del mismo entorno (test con test).
# clerkMiddleware() necesita LAS DOS: la secret para leer el token y la
# publishable para validarlo.
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."

# Firma del webhook de Clerk (dashboard → Webhooks → Signing Secret).
# Sólo hace falta si quieres que los usuarios se sincronicen solos con la DB.
CLERK_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Stripe (opcional). Si falta la secret, el webhook secret o los tres precios,
# el cobro queda deshabilitado: la app arranca igual y todos los usuarios están
# en plan gratuito. No rompe nada.
# ---------------------------------------------------------------------------

# Clave secreta. Dashboard → Developers → API keys.
STRIPE_SECRET_KEY="sk_test_..."

# Firma del webhook.
#   En local: `stripe listen --forward-to localhost:4000/webhooks/stripe --events ...`
#   (comando completo en docs/stripe.md) imprime una clave propia. Esa NO
#   sirve en producción.
#   En producción: Workbench (menú Developers) → pestaña Webhooks →
#     Create new destination → Webhook, con la URL
#     https://<tu-dominio>/webhooks/stripe
#     Acceso directo: https://dashboard.stripe.com/webhooks
# Eventos que hay que activar:
#   - checkout.session.completed               (también concede el de por vida)
#   - checkout.session.async_payment_succeeded (pagos diferidos: SEPA, etc.)
#   - checkout.session.async_payment_failed
#   - customer.subscription.created
#   - customer.subscription.updated
#   - customer.subscription.resumed
#   - customer.subscription.deleted
#   - charge.refunded                          (reembolso total: quita el de por vida)
#   - charge.dispute.closed                    (disputa perdida: quita el de por vida)
#   - invoice.payment_failed
STRIPE_WEBHOOK_SECRET="whsec_..."

# ---------------------------------------------------------------------------
# Los TRES precios del Pro. Dashboard → Products → tu producto → Pricing.
#
# EMPIEZAN CON `price_`, NO CON `prod_`.
# El product id identifica el producto y el price id identifica el precio. Si
# pones un `prod_` aquí, NO DA ERROR: el backend compara el precio de cada
# item contra este valor, la comparación nunca coincide, y el usuario paga y
# queda en gratuito sin que nada avise. Es el error más caro de esta sección
# porque es invisible.
#
# El precio decide el plan, no un flag: por eso los tres ids tienen que estar
# exactamente como los muestra el panel.
# ---------------------------------------------------------------------------

# Mensual. Recurrente.
STRIPE_MONTHLY_PRICE_ID="price_..."

# Anual. Recurrente.
STRIPE_ANNUAL_PRICE_ID="price_..."

# De por vida. PAGO ÚNICO, no recurrente: en Stripe es un precio de una sola
# vez. El checkout de suscripción rechaza los precios que no se renuevan, así
# que el código tiene un camino aparte para éste.
STRIPE_LIFETIME_PRICE_ID="price_..."

# Días de prueba. Va en el mensual y el anual; el de por vida no la admite
# porque no hay nada que renovar después.
STRIPE_TRIAL_DAYS=7
