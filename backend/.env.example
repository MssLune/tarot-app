# Copiar a .env y ajustar según el entorno.

# Ruta del archivo SQLite (relativa a backend/prisma).
DATABASE_URL="file:./dev.db"

# Puerto donde escucha la API.
PORT=4000

# Origen permitido para CORS (el dev server de Vite).
FRONTEND_URL="http://localhost:5173"

# Entorno de ejecución.
NODE_ENV=development

# Clerk (obligatorio para autenticación).
# La secret y la publishable salen de https://dashboard.clerk.com/~/api-keys
# y deben ser del mismo entorno (test con test).
# clerkMiddleware() necesita LAS DOS: la secret para leer el token y la
# publishable para validarlo.
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."

# Firma del webhook de Clerk (dashboard → Webhooks → Signing Secret).
# Sólo hace falta si querés que los usuarios se sincronicen solos con la DB.
CLERK_WEBHOOK_SECRET="whsec_..."
