# Copiar a .env y ajustar según el entorno.

# Ruta del archivo SQLite (relativa a backend/prisma).
DATABASE_URL="file:./dev.db"

# Puerto donde escucha la API.
PORT=4000

# Origen permitido para CORS (el dev server de Vite).
FRONTEND_URL="http://localhost:5173"

# Entorno de ejecución.
NODE_ENV=development

# Clerk (obligatorio para autenticación).
# La secret y la publishable salen de https://dashboard.clerk.com/~/api-keys
# y deben ser del mismo entorno (test con test).
# clerkMiddleware() necesita LAS DOS: la secret para leer el token y la
# publishable para validarlo.
CLERK_SECRET_KEY="sk_test_1AHzc5m0oA6Kslh1F9YD0W0m0L9apACTZ3Hbv4ps1p"
CLERK_PUBLISHABLE_KEY="pk_test_ZXhjaXRpbmctbGFiLTYyNDQuY2xlcmsuYWNjb3VudHMuZGV2JA"

# Firma del webhook de Clerk (dashboard → Webhooks → Signing Secret).
# Sólo hace falta si querés que los usuarios se sincronicen solos con la DB.
CLERK_WEBHOOK_SECRET="whsec_4CDgX/M0pucBxIMzbJKjioJM9TwO7pEB"

# ---------------------------------------------------------------------------
# Stripe (opcional). Si falta cualquiera de las tres, el cobro queda
# deshabilitado: la app arranca igual y todos los usuarios están en plan
# gratuito. No rompe nada.
# ---------------------------------------------------------------------------

# Clave secreta. Dashboard → Developers → API keys.
STRIPE_SECRET_KEY="sk_test_51Tvn9aCnf72vomOYLXTjtDg4JaIm5JhZYp0gQH9YClN3qBTHAuwdsK1QoJstN4VPmrp73U5waBLuNCmp6pPSD1iS007UeA2WjE"

# Firma del webhook. Dashboard → Webhooks → Add endpoint:
#   https://<tu-dominio>/webhooks/stripe
# Eventos que hay que activar:
#   - checkout.session.completed
#   - customer.subscription.created
#   - customer.subscription.updated
#   - customer.subscription.resumed
#   - customer.subscription.deleted
#   - invoice.payment_failed
STRIPE_WEBHOOK_SECRET="whsec_a668fa19a5307c2445bc00ed7fca4936fa9268b96d94b340dc5ddf621563de2e"
#"whsec_zCLWVXO4X06PzQT3mbJ2FW6etg5a8Guw"

# Id del precio de la suscripción Pro. Dashboard → Products → tu producto →
# Pricing → el precio. Empieza con price_ en desarrollo y price_ en producción.
# Es el valor que decide si una suscripción es "pro": el backend compara el
# precio de cada item contra este id, no un flag guardado a mano.
STRIPE_PRO_PRICE_ID="prod_VMPaYeC2e0yOqt"



