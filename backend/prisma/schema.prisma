// Esquema de datos de Arcana.
// Modela contenido editorial (cartas y tiradas predefinidas) y datos de usuario
// (mazos personalizados, tiradas creadas por el usuario y historial de lecturas).

generator client {
  provider      = "prisma-client-js"
  /// "rhel-openssl-3.0.x" es el sistema de las funciones de Vercel.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

/// PostgreSQL (Neon). La app corre en Vercel, que no tiene disco: el archivo
/// SQLite de antes se perdía en cada ejecución.
/// DATABASE_URL: la conexión con pooler (la que usa la app).
/// DIRECT_URL: la directa, sin pooler (la que usan las migraciones).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Usuario autenticado (sincronizado con Clerk).
model User {
  id        String   @id
  email     String   @unique
  name      String?
  avatarUrl String?
  role      String   @default("user") // 'user' | 'admin'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  decks   UserDeck[]
  spreads UserSpread[]
  readings UserReading[]
  rituals UserRitual[]
  subscription Subscription?
  usageEvents UsageEvent[]
  festivalNotes UserFestivalNote[]

  @@map("users")
}

/// Suscripción de pago. DELIBERADAMENTE separada de `User.role`.
///
/// `role` es autorización (quién puede entrar al panel de administración).
/// La suscripción es un hecho económico. Son ortogonales: si se mezclaran en
/// una sola columna, un administrador que cancela perdería permisos, o un
/// suscriptor acabaría con permisos de administración.
///
/// `plan` es lo que nuestra app cree; `status` es lo que Stripe reporta. Puede
/// haber plan "pro" con status "past_due": la tarjeta falló pero todavía
/// existe un período de gracia. Por eso se guardan los dos y no uno solo.
model Subscription {
  id     String @id
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 'free' | 'pro'
  plan   String @default("free")
  /// Lo que reporta Stripe: 'inactive' | 'active' | 'trialing' |
  /// 'past_due' | 'canceled' | 'incomplete' | 'unpaid'.
  status String @default("inactive")

  /// Cuál de los tres Pro compró: 'monthly' | 'annual' | 'lifetime'.
  ///
  /// Va aparte de `plan` porque los tres dan el MISMO plan. Sin esto la app no
  /// puede decir "se renueva el 3 de marzo" y tampoco "no se renueva nunca",
  /// que es justo lo que distingue un pago único de una suscripción.
  ///
  /// 'lifetime' es el único que no tiene `stripeSubscriptionId`: se compró con
  /// un pago de una sola vez y no existe suscripción que lo referencie.
  tier String?

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  stripePriceId        String?

  /// Fin del período que ya está pagado. Si `cancelAtPeriodEnd` es true, la
  /// suscripción sigue activa hasta acá y después baja a free.
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stripeCustomerId])
  @@map("subscriptions")
}

/// Ritual que el usuario anota para sí, con la fuente que él declara.
///
/// IMPORTANTE sobre las fuentes: la app NO verifica que un ritual venga
/// realmente del libro que el usuario escribió. Por eso `sourceVerified`
/// arranca en false y la interfaz muestra "fuente sin verificar" mientras sea
/// false. La app no inventa atribuciones; sólo las guarda.
///
/// Un ritual puede estar ligado a una fase lunar (`phase`, uno de los ocho
/// ids de lib/lunar.ts) o a ninguna (`phase = 'any'`), para los que se hacen
/// cuando uno quiere.
model UserRitual {
  id     String @id
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  /// Qué hacer: los pasos del ritual.
  body     String
  /// Fase lunar a la que aplica, o 'any' si no depende de la fase.
  phase    String  @default("any")
  /// Fuente declarada por el usuario (obra, autor, tradición). Puede ir vacía.
  source   String?
  /// Capítulo, página o sección, si la fuente lo tiene.
  sourceDetail String?
  /// `false` mientras el usuario no haya confirmado que la fuente es correcta.
  /// La UI lo muestra como advertencia, nunca lo oculta ni lo da por bueno.
  sourceVerified Boolean @default(false)

  /// Día local al que el usuario ata el ritual, como 'AAAA-MM-DD'. Es el día
  /// del calendario del usuario, no un instante: por eso texto y no DateTime.
  date        String?
  /// Festividad a la que se ata (id de tarot-core/festivals), si hay.
  festivalId  String?
  /// Notas personales del usuario sobre el ritual.
  notes       String?
  /// Materiales que lleva.
  materials   String?
  /// Cuándo lo marcó como hecho. null = pendiente.
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, phase])
  @@index([userId, date])
  @@map("user_rituals")
}

/// Nota personal sobre una festividad, por año: lo que el usuario quiere
/// recordar de Samhain 2026 no es lo mismo que de Samhain 2027.
model UserFestivalNote {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Id de la festividad (tarot-core/festivals).
  festivalId String
  year       Int
  body       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, festivalId, year])
  @@map("user_festival_notes")
}

/// Carta del Tarot: Arcano Mayor (22) o Arcano Menor (56) — mazo completo de 78.
model Card {
  id     String @id
  /// Índice global único de orden (0-21 Mayores, 22-77 Menores por palo).
  number Int    @unique
  name   String
  glyph  String
  /// Correspondencia astrológica corta, usada como subtítulo en toda la UI (ej. "Aire · Urano").
  correspondence String
  element        String
  axis           String
  energy         String

  /// 'mayor' | 'menor'.
  arcanaType String
  /// Palo del Arcano Menor ('bastos'|'copas'|'espadas'|'oros'); null en Mayores.
  suit       String?
  /// Etiqueta del rango dentro del palo ('As','2'...'10','Sota','Caballero','Reina','Rey'); null en Mayores.
  rank       String?
  /// Valor numérico del rango (1-14) para ordenar dentro de un palo; null en Mayores.
  rankValue  Int?

  /// Listas guardadas como JSON (["palabra1","palabra2"]) — no ameritan una
  /// tabla propia: son atributos simples de la carta, no entidades con
  /// identidad ni relaciones propias.
  keywords         String
  reversedKeywords String

  upright  String
  reversed String
  advice   String

  /// Frases cortas y opcionales que enfocan la lectura de esta carta según el
  /// tema de la pregunta. Se combinan con upright/reversed en el motor de
  /// interpretación; no son párrafos completos para no multiplicar el
  /// contenido a mantener (78 cartas × 4 categorías × 2 orientaciones).
  loveHint   String?
  workHint   String?
  moneyHint  String?
  healthHint String?

  /// --- Contenido de referencia (ficha de la carta), tomado de la guía del
  /// usuario. Siempre asume la carta al derecho, por eso vive aparte de
  /// upright/reversed en vez de mezclarse con el motor de interpretación.
  /// Etiquetas cortas de resumen conceptual (JSON, como keywords).
  conceptTags String?
  /// 'si' | 'no' | 'incierto'. No varía con la orientación: es una cualidad
  /// fija de la carta, no algo que cambie al salir invertida.
  yesNo       String?
  yesNoReason String?
  /// Pasado/Presente/Futuro al derecho (de la guía).
  pastText    String?
  presentText String?
  futureText  String?
  /// Pasado/Presente/Futuro invertido: la misma energía bloqueada, demorada
  /// o vivida hacia adentro, no una simple negación de la versión derecha.
  /// Es contenido propio (la guía original sólo cubre la posición derecha).
  pastTextReversed    String?
  presentTextReversed String?
  futureTextReversed  String?
  /// Signo/regente y rango de fechas tal como los da la guía (ej. "Aries · 21 de marzo al 20 de abril").
  astrology   String?

  /// Nombre del archivo de la imagen de la carta dentro de `assets/cards`, o
  /// null si la carta todavía no tiene.
  ///
  /// Va SÓLO el nombre del archivo y no una ruta, por dos razones. Una: las
  /// lecturas guardadas guardan la carta por id, así que mover la carpeta no
  /// rompe nada. Dos: una ruta guardada en la base es una forma de que alguien
  /// lea un archivo de fuera; el nombre se valida antes de construir la ruta.
  ///
  /// Es opcional a propósito. La app y el PDF funcionan sin ella y dibujan el
  /// símbolo del palo o el número romano. Una carta sin imagen no es una carta
  /// rota, es una carta con el dibujo de siempre.
  image String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cards")
}

/// Conjunto de 2-3 cartas que, si aparecen juntas en una misma tirada
/// (sin importar posición ni orientación), tienen un significado especial
/// propio además del de cada carta por separado.
model CardCombination {
  id      String @id
  name    String
  /// Ids de Card guardados como JSON (["el-diablo","la-luna"]), mismo criterio
  /// que `keywords` en Card: es una lista simple, no una relación con entidad propia.
  cardIds String
  meaning String
  /// Reutiliza la misma paleta de tono que los patrones detectados en el frontend.
  tone    String @default("rose")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("card_combinations")
}

/// Tirada predefinida (ej. "Cruz Celta").
model Spread {
  id          String @id
  name        String
  description String
  /// Familia de layout usada por el creador de tiradas (line/cross/circle/...).
  preset      String?

  positions SpreadPosition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("spreads")
}

/// Una posición dentro de una tirada. Tiene identidad y orden propios,
/// por eso es una tabla relacionada y no un campo JSON dentro de Spread.
model SpreadPosition {
  id       String @id
  spreadId String
  spread   Spread @relation(fields: [spreadId], references: [id], onDelete: Cascade)

  /// Orden dentro de la tirada (reemplaza al índice del array original).
  order  Int
  name   String
  prompt String?
  x      Float
  y      Float
  rotate Float?

  @@index([spreadId])
  @@map("spread_positions")
}

/// Mazo personalizado de un usuario.
model UserDeck {
  id          String @id
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  allowReversed Boolean @default(true)
  /// Cartas del mazo guardadas como JSON.
  cards       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("user_decks")
}

/// Tirada personalizada de un usuario.
model UserSpread {
  id          String @id
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String
  preset      String?
  /// Posiciones de la tirada guardadas como JSON.
  positions   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("user_spreads")
}

/// Lectura guardada por un usuario.
model UserReading {
  id        String @id
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  question  String?
  questionCategory String?
  system    String
  /// Tirada usada (copia JSON).
  spread    String
  /// Mazo usado (copia JSON, opcional).
  deck      String?
  /// Cartas cargadas (JSON).
  cards     String
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("user_readings")
}

/// Datos astronómicos que se piden a un servicio externo y no se calculan.
///
/// Una fila por clave, con el JSON ya limpio. No es una tabla de eclipses: es
/// una caché clave/valor genérica, para que el supermoon o lo que venga
/// después entren acá sin otra migración.
///
/// Existe la fila aunque el año no tenga nada. Un año sin eclipses lunares
/// existe de verdad, y sin la fila el backend lo volvería a preguntar a la
/// API en cada request, para siempre.
model AstronomyCache {
  /// Forma `eclipses-lunares:2026`.
  key String @id

  /// JSON ya reducido a los campos que la app usa. Nunca la respuesta cruda:
  /// la de un año pesa 1,5 MB porque trae la geometría de visibilidad, y
  /// guardar eso para mostrar una fecha sería una locura.
  payload String

  fetchedAt DateTime @default(now())

  @@map("astronomy_cache")
}

/// Registro de cada vez que el usuario USA algo con tope por período (hoy:
/// guardar una lectura). El tope semanal del plan gratuito cuenta estas filas,
/// no las lecturas que existen: si contara las existentes, bastaría con borrar
/// una para poder guardar otra.
model UsageEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Qué se usó: 'readings'.
  resource  String
  createdAt DateTime @default(now())

  @@index([userId, resource, createdAt])
  @@map("usage_events")
}
