node_modules/
dist/
*.tsbuildinfo

# Los PDF de ejemplo que genera tools/ejemplo.ts. Son artefactos, no código.
backend/*.pdf

# Los archivos de imagen de las cartas no se versionan: son varios megas de
# binarios que cambian cada vez que se reemplaza una. La carpeta queda en el
# servidor; el nombre de cada archivo sí está en la base.
backend/assets/cards/*
!backend/assets/cards/README.md

# Las claves (Clerk, Stripe) nunca se versionan. Los .env.example sí.
frontend/.env
backend/.env
.env
*.env.local

# La base SQLite de desarrollo tiene datos de usuarios: no se versiona.
# Se recrea con `npm run db:migrate` y `npm run db:seed`.
backend/prisma/*.db
backend/prisma/*.db-journal
backend/assets/cards/_extraidas/
backend/.entrada/*
!backend/.entrada/LEEME.txt
backend/.entrada/major/
backend/.entrada/minor/
backend/.*.ts

# Salidas de herramientas/renderLuna.ts: PNG para mirar, no código.
frontend/.luna/
